---
import PostCard from "../components/PostCard.astro";
import { getCollection } from 'astro:content';
const rawBlogPosts = await getCollection('blog');

// Get today's current date
const today = new Date();

// Filter for books whose publication date is in the future
const upcomingBooks = rawBlogPosts.filter((post) => {
  // 1. If it's an old post without a book release date, skip it safely!
  if (!post || !post.data || !post.data.bookPubDate) return false;
  
  // 2. If an old post is broken and doesn't have a tags list, skip it safely!
  if (!post.data.tags || !Array.isArray(post.data.tags)) return false;
  
  // 3. Compare the dates for future books
  const releaseTime = new Date(post.data.bookPubDate).getTime();
  const currentTime = today.getTime();
  
  return releaseTime > currentTime;
});

// 4. Sort them so the closest release date is first
const sortedUpcoming = upcomingBooks.sort(
  (a, b) => new Date(a.data.bookPubDate).getTime() - new Date(b.data.bookPubDate).getTime()
);

---

<section class="my-12 px-6 max-w-6xl mx-auto">
  <h2 class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100 mb-6 flex items-center gap-2">
     Upcoming Releases
  </h2>
  
  {sortedUpcoming.length === 0 ? (
    <p class="text-zinc-500 dark:text-zinc-400 italic">No upcoming book reviews at the moment. Check back soon!</p>
  ) : (
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {sortedUpcoming.map((post) => (
        <div class="relative group">
          {/* 1. Reuse the template's official beautiful card */}
          <PostCard post={post} />
          
          {/* 2. Add a tiny custom overlay badge showing the future release date */}
          <div class="mt-2 text-xs font-semibold tracking-wide uppercase text-indigo-600 dark:text-indigo-400">
            📅 Expected Release: {new Date(post.data.bookPubDate).toLocaleDateString('en-US', {
              month: 'long',
              day: 'numeric',
              year: 'numeric'
            })}
          </div>
        </div>
      ))}
    </div>
  )}
</section>
