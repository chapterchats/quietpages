---
import { Image } from 'astro:assets';
import PostCard from "../components/PostCard.astro";
import { getCollection } from 'astro:content';
const rawBlogPosts = await getCollection('blog');

// Get today's current date
const today = new Date();

// Filter for books whose publication date is in the future
const upcomingBooks = rawBlogPosts.filter((post) => {
  // 1. If it's an old post without a book release date, skip it safely!
  if (!post || !post.data || !post.data.bookPubDate) return false;
  
  // 2. If an old post is broken and doesn't have a tags list, skip it safely!
  if (!post.data.tags || !Array.isArray(post.data.tags)) return false;
  
  // 3. Compare the dates for future books
  const releaseTime = new Date(post.data.bookPubDate).getTime();
  const currentTime = today.getTime();
  
  return releaseTime > currentTime;
});

// 4. Sort them so the closest release date is first
const sortedUpcoming = upcomingBooks.sort(
  (a, b) => new Date(a.data.bookPubDate).getTime() - new Date(b.data.bookPubDate).getTime()
);

---

<section class="my-12 px-6 max-w-6xl mx-auto">
  <h2 class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100 mb-6 flex items-center gap-2">
     Upcoming Book Releases
  </h2>
          
  {sortedUpcoming.length === 0 ? (
    <p class="text-zinc-500 dark:text-zinc-400 italic">No new releases at the moment. Check back soon!</p>
  ) : (
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {sortedUpcoming.map((post) => (
        <div class="flex flex-col gap-3 group">
          {/* 1. The Cover Image Container */}
          {post.data.thumbnail && (
            <a href={`/blog/${post.slug || post.id}/`} class="overflow-hidden rounded-xl block aspect-[16/9] bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-800">
              <Image
                src={post.data.thumbnail} 
                alt={post.data.thumbnailAlt || post.data.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              />
            </a>
          )}
          
          {/* 2. Meta Info (Category & Release Date) */}
          <div class="flex items-center gap-3 text-xs uppercase tracking-wider font-semibold mt-1">
           <span class="text-zinc-400 dark:text-zinc-500">{post.data.category.name || "Book Reviews"}</span>
            <span class="text-zinc-400 dark:text-zinc-500">•</span>
            <span class="text-emerald-600 dark:text-emerald-400 font-medium">
              Releasing: {new Date(post.data.bookPubDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
            </span>
          </div>

          {/* 3. Title & Excerpt Description */}
          <div>
            <h3 class="text-xl font-bold text-zinc-900 dark:text-zinc-150 line-clamp-2 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
              <a href={`/blog/${post.slug || post.id}/`}>
                {post.data.title}
              </a>
            </h3>
            <p class="text-sm text-zinc-500 dark:text-zinc-400 mt-2 line-clamp-2">
              {post.data.excerpt || post.data.description}
            </p>
          </div>

          {/* 4. Matching Author Credits & Dynamic Reading Time */}
          <div class="mt-3 text-xs text-muted-foreground">
            {post.data.author?.name || "Caroline D'cruz"} &middot; {Math.max(1, Math.ceil(post.body.trim().split(/\s+/).filter(Boolean).length / 240))} min
          </div>
        </div>
      ))}
    </div>
  )}
</section>

