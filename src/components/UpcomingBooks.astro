---
import { getCollection } from 'astro:content';

const rawBlogPosts = await getCollection('blog');
const today = new Date();

// Filter for books whose publication date is in the future
const upcomingBooks = rawBlogPosts.filter((post) => {
  if (!post || !post.data || post.data.draft || !post.data.bookPubDate) return false;
  
  const releaseTime = new Date(post.data.bookPubDate).getTime();
  const currentTime = today.getTime();
  
  return releaseTime > currentTime;
});

// Sort them so the closest release date is first
const sortedUpcoming = upcomingBooks.sort(
  (a, b) => new Date(a.data.bookPubDate).getTime() - new Date(b.data.bookPubDate).getTime()
);
---

<section class="my-12 px-6 max-w-6xl mx-auto">
  <h2 class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100 mb-6 flex items-center gap-2">
    📅 Upcoming Book Releases
  </h2>
  
  {sortedUpcoming.length === 0 ? (
    <p class="text-zinc-500 dark:text-zinc-400 italic">No upcoming book reviews at the moment. Check back soon!</p>
  ) : (
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {sortedUpcoming.map((post) => (
        <article class="p-5 bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-xl shadow-sm hover:shadow-md transition-shadow">
          <h3 class="text-lg font-semibold text-zinc-950 dark:text-zinc-50 line-clamp-2 mb-2">
            {post.data.title}
          </h3>
          <p class="text-sm text-zinc-500 dark:text-zinc-400 mb-4">
            <strong class="font-medium text-zinc-700 dark:text-zinc-300">Expected Release:</strong>{' '}
            {new Date(post.data.bookPubDate).toLocaleDateString('en-US', {
              month: 'long',
              day: 'numeric',
              year: 'numeric'
            })}
          </p>
          <a 
            href={`/blog/${post.slug || post.id}/`} 
            class="text-sm font-medium text-indigo-600 dark:text-indigo-400 hover:underline inline-flex items-center gap-1"
          >
            Read Sneak Peek →
          </a>
        </article>
      ))}
    </div>
  )}
</section>
