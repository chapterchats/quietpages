---
let { goodreadsUrl, amazonUrl } = Astro.props;

const { frontmatter } = Astro.props;
if (frontmatter) {
  goodreadsUrl = goodreadsUrl || frontmatter.goodreadsUrl;
  amazonUrl = amazonUrl || frontmatter.amazonUrl;
}

if (!goodreadsUrl && !amazonUrl) {
  return null;
}
---

<!-- justify-center centers the buttons horizontally -->
<div class="flex flex-wrap justify-center gap-4 my-10 not-prose w-full">
  {goodreadsUrl && (
    <a 
      href={goodreadsUrl} 
      target="_blank" 
      rel="noopener noreferrer" 
      class="inline-flex items-center justify-center min-w-[180px] px-6 py-2.5 text-sm font-medium tracking-wide text-white bg-[#553b1e] hover:bg-[#443018] rounded transition-colors duration-200 shadow-sm"
    >
      View on Goodreads
    </a>
  )}

  {amazonUrl && (
    <a 
      href={amazonUrl} 
      target="_blank" 
      rel="noopener noreferrer" 
      class="inline-flex items-center justify-center min-w-[180px] px-6 py-2.5 text-sm font-medium tracking-wide text-white bg-[#553b1e] hover:bg-[#443018] rounded transition-colors duration-200 shadow-sm"
    >
      Read Excerpt on Amazon
    </a>
  )}
</div>
