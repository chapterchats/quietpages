---
let { goodreadsUrl, amazonUrl } = Astro.props;

const { frontmatter } = Astro.props;
if (frontmatter) {
  goodreadsUrl = goodreadsUrl || frontmatter.goodreadsUrl;
  amazonUrl = amazonUrl || frontmatter.amazonUrl;
}

if (!goodreadsUrl && !amazonUrl) {
  return null;
}
---

<!-- justify-center centers the buttons horizontally -->
<div class="flex flex-wrap justify-center gap-4 my-10 not-prose w-full">
  {goodreadsUrl && (
    <a 
      href={goodreadsUrl} 
      target="_blank" 
      rel="noopener noreferrer" 
      class="inline-flex items-center justify-center min-w-[190px] px-6 py-2.5 text-sm font-medium tracking-wide text-zinc-900 bg-zinc-100 hover:bg-zinc-200 border border-zinc-300 rounded transition-colors duration-200"
    >
      View on Goodreads
    </a>
  )}

  {amazonUrl && (
    <a 
      href={amazonUrl} 
      target="_blank" 
      rel="noopener noreferrer" 
      class="inline-flex items-center justify-center min-w-[190px] px-6 py-2.5 text-sm font-medium tracking-wide text-zinc-900 bg-zinc-100 hover:bg-zinc-200 border border-zinc-300 rounded transition-colors duration-200"
    >
      Read Excerpt on Amazon
    </a>
  )}
</div>
